# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
# Storage mode: 'local' uses data/ directory; 's3' uses s3a:// paths (Phase 6)
ENVIRONMENT=local

# ── Oracle XE (Docker) ───────────────────────────────────────────────────────
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_DB=XEPDB1
ORACLE_USER=crm_user
ORACLE_PASSWORD=CrmPass123
ORACLE_SYS_PASSWORD=SysPass123

# ── MySQL (Docker) ───────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=retail_master
MYSQL_USER=retail_user
MYSQL_PASSWORD=RetailPass123
MYSQL_ROOT_PASSWORD=RootPass123

# ── AWS (Phase 6 — fill in before Phase 6) ───────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET=your-retail-s3-bucket-name

# ── Redshift Serverless (Phase 6) ────────────────────────────────────────────
REDSHIFT_HOST=your-workgroup.123456789.ap-south-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=dev
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=your-redshift-password
REDSHIFT_IAM_ROLE=arn:aws:iam::123456789012:role/RedshiftS3AccessRole

# ── Spark ────────────────────────────────────────────────────────────────────
# For local dev: local[*]   For Docker cluster: spark://spark-master:7077
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=3g
